# --- Database -------------------------------------------------
# SQLite file (relative to /prisma). For PostgreSQL use: postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# --- Auth -----------------------------------------------------
# Long random string used to sign admin sessions. CHANGE IN PRODUCTION.
AUTH_SECRET="replace-with-64-char-random-string"

# --- Uploads --------------------------------------------------
# Absolute or relative directory where admin uploads are stored (must be persistent on the server).
UPLOAD_DIR="./storage/uploads"
PRIVATE_DIR="./storage/private"

# --- Site -----------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.alahedholding.com"

# --- Initial admin (used by the seed script only) -------------
SEED_ADMIN_EMAIL="admin@alahedholding.com"
SEED_ADMIN_PASSWORD="AlAhed@1975"
